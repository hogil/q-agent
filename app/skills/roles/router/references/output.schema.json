{
  "description": "Always call submit_plan to submit the complete routing object (decision, stage, search_mode, intents, filters, plan, needs_skills, clarification, limitations). Business tools listed in available_tools are NOT callable functions: place their names only in plan[].tool. For an incident-number lookup, set top-level filters to {}, search_mode to sql_exact, put incident_number in plan[0].arguments, and omit arguments.filters when there are no extra conditions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intents",
    "filters",
    "plan",
    "needs_skills",
    "clarification",
    "decision",
    "stage",
    "search_mode",
    "limitations"
  ],
  "properties": {
    "intents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "search",
          "statistics",
          "lot_list",
          "document",
          "analysis",
          "action",
          "wafer_list"
        ]
      }
    },
    "filters": {
      "type": "object"
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "arguments",
          "depends_on",
          "reason"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "arguments": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "needs_skills": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clarification": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "route",
        "execute",
        "clarify",
        "blocked",
        "load_skills",
        "ready_for_judge"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "incident",
        "tools",
        "independent"
      ]
    },
    "search_mode": {
      "type": "string",
      "enum": [
        "none",
        "sql_exact",
        "sql_filter",
        "sql_aggregate",
        "hybrid",
        "mixed"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
