{
  "description": "Return a complete routing object using response_contract.transport. Incident lookup is one action; after valid scope, batch up to four independent currently enabled Tools with known arguments and depends_on=[]. Use clarification=null, needs_skills=[]. Omit unused arguments. Incident numbers use arguments.incident_number, filters={}, search_mode=sql_exact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intents",
    "filters",
    "plan",
    "needs_skills",
    "clarification",
    "decision",
    "stage",
    "search_mode",
    "limitations"
  ],
  "properties": {
    "intents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "search",
          "statistics",
          "lot_list",
          "document",
          "analysis",
          "action",
          "wafer_list"
        ]
      }
    },
    "filters": {
      "type": "object",
      "description": "Copy ONLY plan[0].arguments.filters, or {} if omitted. Do NOT copy standalone arguments such as incident_number, city, title, fields here."
    },
    "plan": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tool",
          "arguments",
          "depends_on",
          "reason"
        ],
        "properties": {
          "tool": {
            "type": "string"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "arguments": {
            "type": "object"
          },
          "reason": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "needs_skills": {
      "description": "Use [] for execute. Use load_skills with plan=[] to request missing topics.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "clarification": {
      "description": "Use null for execute, never an empty string. Only clarify carries a question.",
      "type": [
        "null",
        "string"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "route",
        "execute",
        "clarify",
        "blocked",
        "load_skills",
        "ready_for_judge"
      ]
    },
    "stage": {
      "type": "string",
      "enum": [
        "incident",
        "tools",
        "independent"
      ]
    },
    "search_mode": {
      "type": "string",
      "enum": [
        "none",
        "sql_exact",
        "sql_filter",
        "sql_aggregate",
        "hybrid",
        "mixed"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
