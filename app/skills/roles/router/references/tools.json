{
  "match_incident_values": {
    "enabled": true, "stage": "incident", "search_modes": ["sql_filter"],
    "parameters": {"type": "object", "additionalProperties": false, "properties": {}}
  },
  "find_incidents": {
    "enabled": true, "stage": "incident", "search_modes": ["sql_exact", "sql_filter"],
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "incident_number": {"type": "string"}, "title": {"type": "string"},
        "city": {"type": "string"}, "line": {"type": "string"},
        "title_match": {"type": "string", "enum": ["exact", "contains"]},
        "filters": {"type": "object"},
        "fields": {"type": "array", "items": {"type": "string"}},
        "scope_mode": {"type": "string", "enum": ["candidates", "cohort"]}
      }
    }
  },
  "summarize_incidents": {
    "enabled": true, "stage": "incident", "search_modes": ["sql_aggregate"],
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["filters"],
      "properties": {
        "filters": {"type": "object"},
        "group_by": {"type": "array", "minItems": 1, "maxItems": 3,
          "items": {"type": "string", "enum": ["department", "city", "line", "product_generations", "fab_out_failure_codes"]}},
        "comparison_period": {"type": "object", "additionalProperties": false, "required": ["gte", "lt"],
          "properties": {"gte": {"type": "string"}, "lt": {"type": "string"}}},
        "top_k": {"type": "integer", "minimum": 1}
      }
    }
  },
  "get_engineering_snapshot": {
    "enabled": true, "stage": "tools",
    "parameters": {"type": "object", "additionalProperties": false, "properties": {}}
  },
  "search_related_incidents": {
    "enabled": true, "stage": "tools",
    "parameters": {"type": "object", "additionalProperties": false, "required": ["terms"],
      "properties": {"terms": {"type": "array", "minItems": 1, "maxItems": 6,
                                "items": {"type": "string", "minLength": 2, "maxLength": 80}}}}
  },
  "search_meeting_minutes": {
    "enabled": true, "stage": "tools",
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["query"],
      "properties": {
        "query": {"type": "string"},
        "top_k": {"type": "integer", "minimum": 1}
      }
    }
  },
  "search_engineer_notes": {
    "enabled": false, "stage": "tools",
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["query"],
      "properties": {
        "query": {"type": "string"},
        "top_k": {"type": "integer", "minimum": 1}
      }
    }
  },
  "get_platform_evidence": {
    "enabled": true, "stage": "tools",
    "description": "Read configured local synthetic platform evidence for the already selected incident scope. Sources are bounded and as_of limits event and availability time; this is not a database snapshot or confirmed cause. actor, scope_id, incident_ids, and as_of are bound by code and must not be supplied.",
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "sources": {"type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true,
          "description": "Optional; defaults to all seven configured sources.",
          "items": {"type": "string", "enum": ["mes", "test", "measure", "failbit", "sem", "trend", "inform"]}},
        "limit": {"type": "integer", "minimum": 1, "maximum": 20,
          "description": "Optional maximum returned rows per source; defaults to 12."},
        "measure_features": {"type": "array", "maxItems": 8, "uniqueItems": true,
          "description": "Optional exact names from the configured Measure feature catalogue; requires sources to include measure and tabular analysis to be enabled.",
          "items": {"type": "string", "minLength": 1, "maxLength": 128}}
      }
    }
  },
  "search_platform_history": {
    "enabled": true, "stage": "tools",
    "description": "Find bounded synthetic historical incident references for one selected incident. Similarity is not cause or probability, and historical references are not part of the affected scope. actor, scope_id, incident_ids, and as_of are bound by code and must not be supplied.",
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "top_k": {"type": "integer", "minimum": 1, "maximum": 10,
          "description": "Optional number of historical references to return; defaults to 5. Requires exactly one selected incident."}
      }
    }
  },
  "search_similar_fbm": {
    "enabled": false, "stage": "tools",
    "description": "Synthetic/unverified design only. Search separately by source representation after current incident, Lot, and Wafer lookups are complete. actor, incident scope, and as_of are bound by trusted code; source_incident_id/lot_id/wafer_id/representation must match that completed lookup tuple. Candidates must be distinguished as the current selected incident or a historical candidate previously returned by search_related_incidents; historical candidates are not current affected Wafers or causes. Each representation is queried and returned independently; missing results mean unknown. Similarity is not cause probability or a guarantee of normality. Lineage, geometry/coordinates, actual DB/storage, ACL, and model are unverified. Available only when both config enabled and a callable trusted adapter are present.",
    "parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["source_incident_id", "lot_id", "wafer_id", "representation"],
      "properties": {
        "source_incident_id": {"type": "string", "minLength": 1},
        "lot_id": {"type": "string", "minLength": 1},
        "wafer_id": {"type": "string", "minLength": 1},
        "representation": {"type": "string", "enum": ["raw_fbm", "object_id_yield_fbm"]},
        "top_k": {"type": "integer", "minimum": 1, "maximum": 50}
      }
    }
  },
  "search_internal_documents": {
    "enabled": false, "stage": "tools",
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["query"],
      "properties": {
        "query": {"type": "string"},
        "top_k": {"type": "integer", "minimum": 1}
      }
    }
  },
  "search_mes_reference": {
    "enabled": false, "stage": "tools",
    "description": "Search configured synthetic MES reference data. kind and query remain required; query is a name substring search. Optional filters are 1-5 configured logical key/value exact-match conditions combined with AND. Keys must be explicitly allowed and mapped by configuration; do not invent physical fields or infer MES semantics. actor, scope, incident_ids, and as_of are bound by code and must not be supplied. This contract does not establish production MES source, ACL, or mapping validation.",
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["kind", "query"],
      "properties": {
        "kind": {"type": "string"},
        "query": {"type": "string"},
        "top_k": {"type": "integer", "minimum": 1},
        "filters": {
          "type": "object", "minProperties": 1, "maxProperties": 5,
          "propertyNames": {"type": "string", "minLength": 1, "maxLength": 64,
            "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 128},
          "description": "Optional configured logical field names mapped and allowed by the administrator. Exact string equality; all supplied conditions are ANDed. Omit when the requested field/value is unclear; do not guess."
        }
      }
    }
  },
  "list_comparison_assets": {
    "enabled": true, "stage": "tools",
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["item", "modality"],
      "properties": {"item": {"type": "string"}, "modality": {"type": "string", "enum": ["sem", "overlay"]}}
    }
  },
  "compare_sem_images": {
    "enabled": true, "stage": "tools",
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["item", "asset_ids"],
      "properties": {"item": {"type": "string"}, "asset_ids": {"type": "array", "items": {"type": "string"}}}
    }
  },
  "compare_overlay_maps": {
    "enabled": true, "stage": "tools",
    "parameters": {
      "type": "object", "additionalProperties": false, "required": ["item", "asset_ids"],
      "properties": {"item": {"type": "string"}, "asset_ids": {"type": "array", "items": {"type": "string"}}}
    }
  },
  "list_incident_lots": {
    "enabled": true, "stage": "tools",
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {"page_size": {"type": "integer", "minimum": 1}, "offset": {"type": "integer", "minimum": 0}}
    }
  },
  "list_incident_wafers": {
    "enabled": true, "stage": "tools",
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "page_size": {"type": "integer", "minimum": 1}, "offset": {"type": "integer", "minimum": 0},
        "lot_ids": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "plan_synthetic_action_evidence": {
    "enabled": false, "stage": "tools",
    "parameters": {"type": "object", "additionalProperties": false, "properties": {}}
  }
}
