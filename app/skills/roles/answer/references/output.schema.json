{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claims",
    "answer",
    "limitations",
    "status"
  ],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "claim_id",
          "text",
          "evidence_ids"
        ],
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "inspection_plan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["historical_matches", "checks", "eds_followup"],
      "properties": {
        "historical_matches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "basis", "comparison", "evidence_ids"],
            "properties": {
              "target": {"type": "string"}, "basis": {"type": "string"},
              "comparison": {"type": "string"},
              "evidence_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "checks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "basis", "comparison", "evidence_ids"],
            "properties": {
              "target": {"type": "string"}, "basis": {"type": "string"},
              "comparison": {"type": "string"},
              "evidence_ids": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "eds_followup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["target", "basis", "comparison", "evidence_ids"],
          "properties": {
            "target": {"type": "string"}, "basis": {"type": "string"},
            "comparison": {"type": "string"},
            "evidence_ids": {"type": "array", "items": {"type": "string"}}
          }
        }
      }
    },
    "answer": {
      "type": "string"
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "answered",
        "partial",
        "unavailable"
      ]
    }
  }
}
