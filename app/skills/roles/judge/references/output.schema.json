{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "issues",
    "return_to",
    "coverage"
  ],
  "properties": {
    "verdict": {
      "type": "string",
      "enum": [
        "pass",
        "revise",
        "need_evidence",
        "abstain"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "evidence_ids",
          "type",
          "reason",
          "next_action"
        ],
        "properties": {
          "type": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "next_action": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "return_to": {
      "type": "string",
      "enum": [
        "router",
        "answer"
      ]
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requirement",
          "status",
          "evidence_ids"
        ],
        "properties": {
          "requirement": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "missing",
              "conflict",
              "unavailable"
            ]
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
