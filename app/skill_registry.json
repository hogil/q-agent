  "topic_dependencies": {
    "lots": ["incident_search"],
    "wafers": ["lots"]
  },
  "max_prompt_characters": 70000,
  "notes": [
    "temperature=0 reduces sampling variability but does not guarantee deterministic serving",
    "topic/reference loads are explicit; arbitrary filesystem paths are prohibited",
    "Maintenance is an offline development workflow, not an online user-triggered role",
    "Model deployment and revision limits come from config/config.yaml plus site overlay; compile_prompt without settings is source validation only.",
    "Role output contracts require decision/stage/search_mode, Judge coverage/return_to and Answer status. 70000 character ceiling accommodates broad registered topic combinations with lossless column encoding; this is a compiler character-count guard, not a provider token limit. Character-to-token conversion has not been measured, and broad requests increase actual usage.",
    "ReAct rules live in core/references/react.md; Router tool parameters live in its references/tools.json. All roles and schemas resolve through this registry."
  ],
  "platform_review_base": [
    "core",
    "schema/platform-schema",
    "rules/platform-analysis"
  ],
  "platform_review_roles": {
    "judge": "roles/platform-judge",
    "answer": "roles/platform-answer"
  }
}
