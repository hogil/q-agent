{
  "release": "quality-demo-0.83",
  "purpose": "on-prem application Skill sources; not personal ChatGPT skill installation",
  "base": [
    "core"
  ],
  "roles": {
    "router": "roles/router",
    "answer": "roles/answer",
    "judge": "roles/judge"
  },
