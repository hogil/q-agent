    ],
    "trends": [
      "schema/trend-metadata-schema"
    ],
    "wafers": [
      "schema/incident-schema",
      "schema/lot-schema",
      "schema/wafer-schema"
    ],
    "incident_search": [
      "schema/incident-schema"
    ],
