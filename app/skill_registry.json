{
  "release": "quality-demo-0.6",
  "purpose": "on-prem application Skill sources; not personal ChatGPT skill installation",
  "base": [
    "quality-core"
  ],
  "roles": {
    "router": "quality-router",
    "answer": "quality-answer",
    "judge": "quality-judge"
  },
  "topics": {
    "terminology": [
      "quality-terminology"
    ],
    "schema": [
      "quality-incident-schema"
    ],
    "lots": [
      "quality-incident-schema",
      "quality-lot-schema",
      "quality-lot-retrieval"
    ],
    "statistics": [
      "quality-incident-schema",
      "quality-statistics"
    ],
    "documents": [
      "quality-incident-document-schema",
      "quality-document-chunk-schema",
      "quality-document-evidence"
    ],
    "actions": [
      "quality-actions"
    ],
    "maintenance": [
      "quality-skill-maintenance"
    ],
    "images": [
      "quality-image-metadata-schema"
    ],
    "trends": [
      "quality-trend-metadata-schema"
    ]
  },
  "role_allowed_topics": {
    "router": [
      "terminology",
      "schema",
      "lots",
      "statistics",
      "documents",
      "actions",
      "images",
      "trends"
    ],
    "answer": [
      "terminology",
      "schema",
      "lots",
      "statistics",
      "documents",
      "actions",
      "images",
      "trends"
    ],
    "judge": [
      "schema",
      "lots",
      "statistics",
      "documents",
      "actions",
      "images",
      "trends"
    ]
  },
  "max_prompt_characters": 18000,
  "notes": [
    "temperature=0 reduces sampling variability but does not guarantee deterministic serving",
    "topic/reference loads are explicit; arbitrary filesystem paths are prohibited",
    "Maintenance is an offline development workflow, not an online user-triggered role",
    "Model deployment and revision limits come from config/default.toml plus site overlay; compile_prompt without settings is source validation only."
  ]
}
