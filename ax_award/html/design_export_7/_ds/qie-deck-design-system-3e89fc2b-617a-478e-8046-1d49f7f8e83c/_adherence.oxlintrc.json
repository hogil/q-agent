{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "ui_kits/deck/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Malgun Gothic|Noto Sans KR))/i]",
        "message": "Font not provided by the design system. Available: Malgun Gothic, Noto Sans KR."
      },
      {
        "selector": "JSXOpeningElement[name.name='BeforeAfter'] > JSXAttribute > JSXIdentifier[name!=/^(?:before|after|beforeLabel|afterLabel|style|key|ref|className|style|children)$/]",
        "message": "<BeforeAfter> doesn't accept that prop. Declared props: before, after, beforeLabel, afterLabel, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|disabled|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: children, variant, size, disabled."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|navy|outline|ghost)$/]",
        "message": "<Button> variant must be one of 'primary' | 'navy' | 'outline' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|style|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: children, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|navy|panel|tealSoft|outline)$/]",
        "message": "<Chip> tone must be one of 'teal' | 'navy' | 'panel' | 'tealSoft' | 'outline'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataTable'] > JSXAttribute > JSXIdentifier[name!=/^(?:headers|rows|highlightRow|align|style|key|ref|className|style|children)$/]",
        "message": "<DataTable> doesn't accept that prop. Declared props: headers, rows, highlightRow, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowBox'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|sub|tags|tone|style|key|ref|className|style|children)$/]",
        "message": "<FlowBox> doesn't accept that prop. Declared props: title, sub, tags, tone, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowBox'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:navy|navy2|teal|panel)$/]",
        "message": "<FlowBox> tone must be one of 'navy' | 'navy2' | 'teal' | 'panel'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|accent|accentColor|bordered|pad|style|key|ref|className|style|children)$/]",
        "message": "<Panel> doesn't accept that prop. Declared props: children, tone, accent, accentColor, bordered, pad, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:panel|white|navy|teal-tint)$/]",
        "message": "<Panel> tone must be one of 'panel' | 'white' | 'navy' | 'teal-tint'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Panel'] > JSXAttribute[name.name='accent'] > Literal[value!=/^(?:top|left)$/]",
        "message": "<Panel> accent must be one of 'top' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ProgressRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|current|style|key|ref|className|style|children)$/]",
        "message": "<ProgressRail> doesn't accept that prop. Declared props: items, current, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:big|label|sub|tone|align|style|key|ref|className|style|children)$/]",
        "message": "<StatCard> doesn't accept that prop. Declared props: big, label, sub, tone, align, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:teal|gold)$/]",
        "message": "<StatCard> tone must be one of 'teal' | 'gold'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatCard'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:center|left)$/]",
        "message": "<StatCard> align must be one of 'center' | 'left'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TimelineItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:date|label|sub|done|key|ref|className|style|children)$/]",
        "message": "<TimelineItem> doesn't accept that prop. Declared props: date, label, sub, done."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:kicker|title|subtitle|size|style|key|ref|className|style|children)$/]",
        "message": "<TitleBlock> doesn't accept that prop. Declared props: kicker, title, subtitle, size, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='TitleBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:heading|title)$/]",
        "message": "<TitleBlock> size must be one of 'heading' | 'title'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
